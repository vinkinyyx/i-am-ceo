# tap-auth 环境变量示例（只填占位符，禁止提交真实密钥）
# 小游戏 MiniApp ID（TapTap 开发者后台）
TAP_MINIAPP_ID=your-miniapp-id
# 小游戏 Server Secret，仅服务端持有，不得下发客户端
TAP_MINIAPP_SECRET=your-miniapp-server-secret
# 游戏 AppID（写入 session aud 与响应 appId）
GAME_APP_ID=1016161
# 运行环境：test 或 production
GAME_ENV=test
# profileId 派生密钥（HMAC-SHA256），使用长随机串，换值会导致全部 profileId 变化
PROFILE_HMAC_KEY=replace-with-a-long-random-string
# session token 签名密钥，使用另一条长随机串
SESSION_SIGNING_KEY=replace-with-another-long-random-string

# 可选：覆盖上游 code2Session 完整地址（仅测试/联调使用）
# TAP_CODE2SESSION_URL=https://cloud-miniapp.tapapis.cn/auth/v1/jscode2session
# 可选：会话有效期秒数，范围 60..3600，默认 900
# SESSION_TTL_SEC=900
# 可选：本地 node:http 监听端口，默认 8787
# PORT=8787
