{
  "name": "im-ceo",
  "version": "0.1.0",
  "description": "《我是CEO》第一阶段 MVP - TapTap 普通小游戏（Cocos Creator 3.8.8 + TypeScript）",
  "creator": {
    "version": "3.8.8"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.ui.json --noEmit",
    "check": "npm run typecheck && npm run typecheck:ui && npm run lint && npm run test",
    "lint": "eslint \"assets/core/**/*.ts\" \"assets/scripts/**/*.ts\" \"tests/**/*.ts\"",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:golden": "vitest run --dir tests/golden",
    "test": "vitest run",
    "web-build": "powershell -ExecutionPolicy Bypass -File tools/build-web.ps1",
    "tap-build": "powershell -ExecutionPolicy Bypass -File tools/build-tap.ps1",
    "release-build": "powershell -ExecutionPolicy Bypass -File tools/build-tap-v2.ps1",
    "static-server": "node tools/static-server.cjs build/web-mobile 8123"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "uuid": "9f1dcfb5-71f2-4eae-9c27-d572ded6a8a4"
}
